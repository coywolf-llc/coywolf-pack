---
/**
 * Download card for the coywolf-file Portable Text block: file-type badge,
 * name, "TYPE · size · Uploaded date", Download and Copy link. Renders
 * nothing when File Downloads is off or the file no longer exists. Markup and
 * CSS come from files/card.ts, which the admin preview uses too.
 */
import { siteFeatureOn } from "../../core/features.js";
import { noteReadFailure } from "../../core/read-failures.js";
import { workerEnv } from "../../shared.js";
import { FILE_CSS, renderFileCardHtml } from "../../files/card.js";
import { downloadPath } from "../../files/format.js";
import { readSiteSettings, resolveFile } from "../../files/site.js";

interface Props {
	node: {
		_key?: string;
		id?: string;
		title?: string;
		description?: string;
		showIcon?: boolean;
		showDescription?: boolean;
		showMeta?: boolean;
		showDownload?: boolean;
		showCopyLink?: boolean;
	};
}

const { node } = Astro.props;

let html = "";
if (node?.id && (await siteFeatureOn("files"))) {
	try {
		const env = await workerEnv();
		const db = env.DB as D1Database | undefined;
		const file = db ? await resolveFile(db, String(node.id)) : null;
		if (db && file) {
			const settings = await readSiteSettings(db);
			const href = downloadPath(settings.base, file.id, file.name);
			html = renderFileCardHtml(
				{
					title: node.title?.trim() || file.name,
					description: node.description?.trim() ?? "",
					name: file.name,
					size: file.size,
					uploadedAt: file.uploadedAt,
					href,
					absolute: new URL(href, Astro.url).href,
				},
				{
					scheme: settings.scheme,
					accent: settings.accent,
					showIcon: node.showIcon,
					showDescription: node.showDescription,
					showMeta: node.showMeta,
					showDownload: node.showDownload,
					showCopyLink: node.showCopyLink,
				},
			);
		}
	} catch (error) {
		console.error("coywolf-pack files: could not render a download card", error);
		// The page goes out without its card: not into the edge cache.
		noteReadFailure();
	}
}

// The CSS goes out once per page, before the first card.
const locals = (Astro.locals ?? {}) as Record<string, unknown>;
const css = html && !locals.__cwFileCss ? FILE_CSS : "";
if (css) locals.__cwFileCss = true;
---

{css && <style is:inline set:html={css} />}
{html && <Fragment set:html={html} />}

<script>
	// Copy link: clipboard, checkmark swap, and a polite announcement. One delegated listener per page.
	const timers = new WeakMap<Element, number>();
	document.addEventListener("click", async (event) => {
		const target = event.target instanceof Element ? event.target : null;
		const button = target?.closest<HTMLButtonElement>(".cw-file__copy");
		if (!button) return;
		const url = button.dataset.cwFileUrl;
		const status = button.closest(".cw-file")?.querySelector(".cw-file__sr");
		if (!url) return;
		try {
			await navigator.clipboard.writeText(url);
			button.classList.add("is-copied");
			if (status) status.textContent = "Link copied";
			clearTimeout(timers.get(button));
			timers.set(
				button,
				window.setTimeout(() => {
					button.classList.remove("is-copied");
					if (status) status.textContent = "";
				}, 2000),
			);
		} catch {
			if (status) status.textContent = "Could not copy the link.";
		}
	});
</script>
