{
	"name": "@coywolf/emdash",
	"version": "0.35.2",
	"description": "Coywolf Pack for EmDash: one plugin with Coywolf's features for EmDash sites on Cloudflare. Full backups and restore, a redirect manager, and more to come.",
	"license": "MIT",
	"author": "Coywolf LLC (https://coywolf.com)",
	"homepage": "https://github.com/coywolf-llc/coywolf-pack",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/coywolf-llc/coywolf-pack.git"
	},
	"type": "module",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"coywolf",
		"backup",
		"restore",
		"redirects",
		"cloudflare",
		"d1",
		"r2"
	],
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin/index.tsx",
		"./astro": "./src/astro/index.ts",
		"./middleware": "./src/middleware.ts",
		"./forms": "./src/forms.ts"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --import ./test/ts-resolve.mjs --test \"test/**/*.test.mjs\" \"src/**/*.test.ts\" \"src/**/*.test.mjs\""
	},
	"peerDependencies": {
		"@cloudflare/kumo": "*",
		"@emdash-cms/plugin-forms": ">=0.2.9",
		"@phosphor-icons/react": "^2.1.0",
		"@tanstack/react-query": "^5.0.0",
		"astro": ">=6.0.0",
		"emdash": ">=1.2.0",
		"highlight.js": "^11.0.0",
		"lowlight": "^3.0.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"zod": "^3.24.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"@emdash-cms/plugin-forms": {
			"optional": true
		}
	},
	"devDependencies": {
		"@cloudflare/kumo": "*",
		"@cloudflare/workers-types": "^4.0.0",
		"@phosphor-icons/react": "^2.1.0",
		"@tanstack/react-query": "^5.0.0",
		"@types/react": "^19.0.0",
		"astro": "^7.3.0",
		"emdash": "^1.3.0",
		"react": "^19.0.0",
		"typescript": "^5.9.0",
		"zod": "^4.6.0"
	}
}
