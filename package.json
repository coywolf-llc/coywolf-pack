{
	"name": "@coywolf/emdash",
	"version": "0.37.1",
	"description": "Coywolf Pack for EmDash: one plugin that enhances EmDash sites on Cloudflare. Page cache and warming, clean image URLs, backups and restore, redirects, Schema.org and Open Graph, RSS, news sitemap and llms.txt, robots.txt rules, live search, link checking, headings and table of contents, breadcrumbs, code highlighting, file downloads, Cloudflare Stream videos, reviews, custom blocks, AI enrichment and WordPress import.",
	"license": "MIT",
	"author": "Coywolf LLC (https://coywolf.com)",
	"homepage": "https://github.com/coywolf-llc/coywolf-pack",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/coywolf-llc/coywolf-pack.git"
	},
	"type": "module",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"coywolf",
		"cloudflare",
		"cloudflare-workers",
		"d1",
		"r2",
		"page-cache",
		"images",
		"backup",
		"restore",
		"redirects",
		"seo",
		"schema",
		"json-ld",
		"open-graph",
		"rss",
		"llms-txt",
		"robots-txt",
		"search",
		"link-checker",
		"table-of-contents",
		"breadcrumbs",
		"syntax-highlighting",
		"cloudflare-stream",
		"video",
		"reviews",
		"wordpress-import"
	],
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin/index.tsx",
		"./astro": "./src/astro/index.ts",
		"./middleware": "./src/middleware.ts",
		"./worker": "./src/worker.ts",
		"./forms": "./src/forms.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.mjs",
		"README.md",
		"LICENSE",
		"docs"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --import ./test/ts-resolve.mjs --test \"test/**/*.test.mjs\" \"src/**/*.test.ts\" \"src/**/*.test.mjs\""
	},
	"peerDependencies": {
		"@cloudflare/kumo": "*",
		"@emdash-cms/plugin-forms": ">=0.2.9",
		"@phosphor-icons/react": "^2.1.0",
		"@tanstack/react-query": "^5.107.1",
		"astro": ">=6.0.0",
		"emdash": ">=1.4.0",
		"highlight.js": "^11.0.0",
		"lowlight": "^3.0.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"zod": "^3.24.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"@emdash-cms/plugin-forms": {
			"optional": true
		}
	},
	"devDependencies": {
		"@cloudflare/kumo": "2.6.0",
		"@cloudflare/workers-types": "^5.20261102.1",
		"@phosphor-icons/react": "^2.1.0",
		"@tanstack/react-query": "^5.107.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"astro": "^7.4.7",
		"emdash": "^1.4.0",
		"happy-dom": "^21.0.4",
		"kysely": "^0.29.8",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^5.9.0",
		"zod": "^4.6.7"
	},
	"overrides": {
		"zod@4.5.4": "4.6.7"
	},
	"publishConfig": {
		"access": "public"
	},
	"bugs": {
		"url": "https://github.com/coywolf-llc/coywolf-pack/issues"
	}
}
